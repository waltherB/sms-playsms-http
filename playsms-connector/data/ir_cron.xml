<odoo>
    <data noupdate="1">
        <!-- DAILY CHECK CREDIT BALANCE -->
        <record id="ir_cron_check_tokens" model="ir.cron">
            <field name="name">PlaySMS: Check credit balance</field>
            <field name="model_id" ref="iap.model_iap_account"/>
            <field name="state">code</field>
            <field name="code">model.check_sms_api_playsms_credit_balance()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
