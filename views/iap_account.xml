<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="iap_account_view_form" model="ir.ui.view">
        <field name="name">playsms.iap.account.view.form</field>
        <field name="model">iap.account</field>
        <field name="inherit_id" ref="iap.iap_account_view_form" />
        <field name="arch" type="xml">
            <!-- PlaySMS settings -->
            <xpath expr="//group[@name='account']" position="after">
                <group
                    string="PlaySMS account"
                    name="group_sms_api_playsms"
                    invisible="provider != 'sms_api_playsms'"
                >
                    <field name="service_name"/>
                    <field name="sms_api_url" string="Url of PlaySMS server" required="provider == 'sms_api_playsms'"/>
                    <field name="sms_api_username" string="Username" required="provider == 'sms_api_playsms'"/>
                    <field name="sms_api_password" string="Webtoken" password="True" required="provider == 'sms_api_playsms'"/>
                    <field name="sms_api_from" string="From" required="provider == 'sms_api_playsms'"/>
                    <field name="sms_api_min_tokens"/>
                    <field name="sms_api_token_notification_action" invisible="sms_api_min_tokens &lt; 0"/>
                    <field name="sms_api_playsms_connection_status" invisible="sms_api_playsms_connection_status == False" readonly="True"/>
                    <button name="sms_api_playsms_connection_test" string="Test Connection" type="object" class="oe_highlight"/>
                </group>
            </xpath>

            <!-- Chatter -->
            <xpath expr="//sheet" position="after">
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>